{
  "name": "codex-relay",
  "private": true,
  "version": "0.1.0",
  "description": "Codex cross-device conversation relay (M2 implementation)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm --filter @relay/relay start",
    "test": "pnpm -r test",
    "test:relay": "pnpm --filter @relay/relay test",
    "test:bridge": "pnpm --filter @relay/bridge test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
